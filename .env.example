# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LINE Messaging API (per-hotel token also stored in hotels.line_channel_access_token,
# this is a fallback / shared StayFlow channel for local dev)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Optional: required Authorization: Bearer <CRON_SECRET> header for
# /api/cron/overdue-followups (see vercel.json)
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
